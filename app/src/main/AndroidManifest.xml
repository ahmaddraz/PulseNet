<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- صلاحيات ما قبل أندرويد 12 (API أقل من 31) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" /> <!-- صلاحيات أندرويد 12 وما فوق (API 31+) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" /> <!-- صلاحية الإشعارات (لازمة من أندرويد 13 فما فوق) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- صلاحية تشغيل خدمة خلفية دايمة (Foreground Service) خاصة بالبلوتوث -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" /> <!-- صلاحية الإنترنت (لازمة لمزامنة لوحة تحكم الأدمن عبر السيرفر لاحقاً) -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- التطبيق يحتاج BLE فعلياً بشكل أساسي -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PulseNet"
        tools:targetApi="31">
        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".NearbyDevicesActivity"
            android:exported="false" />
        <activity
            android:name=".InfoDetailActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".AddInfoActivity"
            android:exported="false" />
        <activity
            android:name=".Onboarding3Activity"
            android:exported="false" />
        <activity
            android:name=".Onboarding2Activity"
            android:exported="false" />
        <activity
            android:name=".Onboarding1Activity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <service
            android:name=".service.PulseNetService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>