<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:layoutDirection="ltr"
    android:fitsSystemWindows="true"
    android:paddingTop="24dp"
    android:paddingBottom="20dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- العنوان -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="معلومة جديدة"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- صف خيارات التصنيف -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/option_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_option_inactive"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="موقع"
            android:textColor="@color/color_text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/option_help"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_option_inactive"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="مساعدة"
            android:textColor="@color/color_text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/option_service"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_option_inactive"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="خدمة"
            android:textColor="@color/color_text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/option_emergency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_option_active"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="طوارئ"
            android:textColor="@color/color_background"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

    <!-- حقل عنوان المعلومة -->

    <!-- حقل تفاصيل إضافية -->
    <EditText
        android:id="@+id/input_title"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|right"
        android:textAlignment="viewEnd"
        android:hint="عنوان المعلومة"
        android:textColorHint="@color/color_placeholder_text"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:padding="12dp"
        android:inputType="textMultiLine" />

    <EditText
        android:id="@+id/input_details"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|right"
        android:textAlignment="viewEnd"
        android:hint="تفاصيل إضافية"
        android:textColorHint="@color/color_placeholder_text"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:padding="12dp"
        android:inputType="textMultiLine" />

    <!-- صف المنطقة والأولوية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:gravity="right"
            android:textAlignment="viewEnd"
            android:hint="المنطقة"
            android:textColorHint="@color/color_placeholder_text"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/input_priority"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="right"
            android:textAlignment="viewEnd"
            android:hint="الأولوية"
            android:textColorHint="@color/color_placeholder_text"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:padding="12dp" />

    </LinearLayout>

    <!-- مساحة فاضية تدفع الزر للأسفل -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- زر النشر -->
    <TextView
        android:id="@+id/button_publish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_cyan"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="نشر للمجاورين"
        android:textColor="@color/color_background"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:gravity="center" />

</LinearLayout>