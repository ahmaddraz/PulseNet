<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/color_background"
    android:paddingStart="36dp"
    android:paddingEnd="36dp">

    <!-- دائرة الأيقونة -->
    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_list_checks" />

    </FrameLayout>

    <!-- العنوان -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="من الطوارئ للخدمات، بضغطة وحدة"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- النص الفرعي -->
    <TextView
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="صنّف أي معلومة (طوارئ، خدمة، مساعدة، موقع) وحدد أولويتها، لتصل بالشكل الصح لمن يحتاجها فعلاً"
        android:textColor="#7C8699"
        android:textSize="11sp"
        android:gravity="center" />

    <!-- نقاط التقدم -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="16dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_dot_active" />

    </LinearLayout>

    <!-- زر ابدأ الآن -->
    <TextView
        android:id="@+id/button_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_cyan"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="ابدأ الآن"
        android:textColor="@color/color_background"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:gravity="center" />

</LinearLayout>