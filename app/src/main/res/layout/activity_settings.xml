<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:layoutDirection="ltr"
    android:fitsSystemWindows="true"
    android:paddingTop="24dp"
    android:paddingBottom="20dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- العنوان -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الإعدادات"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="right"
        android:textAlignment="viewEnd" />

    <!-- صف الملف الشخصي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person" />

        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم الجهاز"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_device_name_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="جهاز-a1f2"
                android:textColor="@color/color_text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- صف: البث المستمر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <Switch
            android:id="@+id/switch_broadcast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumbTint="@color/white"
            android:trackTint="@color/color_button_cyan" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📶 البث المستمر"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- صف: الإشعارات المحلية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <Switch
            android:id="@+id/switch_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumbTint="@color/white"
            android:trackTint="@color/color_button_cyan" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔 الإشعارات المحلية"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- صف: الأجهزة المتصلة -->
    <LinearLayout
        android:id="@+id/row_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 الأجهزة المتصلة"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- صف: مساحة التخزين -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/text_storage_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.2MB"
            android:textColor="@color/color_text_secondary"
            android:textSize="9.5sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾 مساحة التخزين"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- مساحة فاضية تدفع الفوتر للأسفل -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- زر إعادة تشغيل الخدمة -->
    <TextView
        android:id="@+id/button_restart_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_option_inactive"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="🔄 أعد تشغيل البث والاكتشاف"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- الفوتر -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PulseNet · الإصدار 1.0"
        android:textColor="@color/color_placeholder_text"
        android:textSize="10sp"
        android:gravity="center" />

</LinearLayout>